APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:81
APP_PORT=81
FORWARD_DB_PORT=5433
FORWARD_VALKEY_PORT=6380
FORWARD_MAILPIT_PORT=1026
FORWARD_MAILPIT_DASHBOARD_PORT=8026
FORWARD_TYPESENSE_PORT=8109

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_BASE_URL=
AUTHENTIK_REDIRECT_URI="${APP_URL}/auth/authentik/callback"

# AI Integration (optional). Runtime values come from the app_settings table
# (Admin → AI Settings); these env values are only the boot-time defaults.
MEDIAMANAGER_AI_ENABLED=false
MEDIAMANAGER_AI_DEFAULT_AGENT=command
MEDIAMANAGER_AI_MODE=executive
MEDIAMANAGER_AI_COMMAND_MODEL=gpt-5-mini
MEDIAMANAGER_AI_ADVISOR_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Service Connection Seeder (optional — set any of these and run `artisan db:seed --class=ServiceConnectionSeeder` to create connections automatically)
SONARR_URL=
SONARR_API_KEY=
SONARR_WEBHOOK_TOKEN=
SONARR_NAME=

RADARR_URL=
RADARR_API_KEY=
RADARR_WEBHOOK_TOKEN=
RADARR_NAME=

EMBY_URL=
EMBY_API_KEY=
EMBY_WEBHOOK_TOKEN=
EMBY_NAME=

SEERR_URL=
SEERR_API_KEY=
SEERR_WEBHOOK_TOKEN=
SEERR_NAME=

PROWLARR_URL=
PROWLARR_API_KEY=
PROWLARR_WEBHOOK_TOKEN=
PROWLARR_NAME=
