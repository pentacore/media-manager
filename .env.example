# Development env. Copy to `.env` then run `vendor/bin/sail artisan key:generate`.
# Defaults match `compose.yaml` service hostnames so `vendor/bin/sail up -d` works
# out of the box. Override `APP_PORT` / `FORWARD_*` if host ports clash.

APP_NAME=MediaManager
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# ----- Sail forwarded ports (host → container) -----
APP_PORT=80
FORWARD_DB_PORT=5432
FORWARD_VALKEY_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
FORWARD_TYPESENSE_PORT=8108
REVERB_PORT=8080
VITE_PORT=5173

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ----- Logging (stack → single file + stderr) -----
LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----- Database (pgsql sail service) -----
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

# ----- Session / cache / queue → redis (valkey) -----
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

# ----- Redis (valkey sail service) -----
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CACHE_DB=1
REDIS_DB=0

# ----- Broadcasting (reverb sail service) -----
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=1001
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
# REVERB_HOST is server-side: how Laravel reaches reverb. With reverb in its
# own sail container use the service name (`reverb`); single-container use `localhost`.
REVERB_HOST=reverb
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# REVERB_PUBLIC_* is browser-facing (rendered into <meta name="reverb-config">).
# Defaults to APP_URL host. Override only if it differs (e.g. behind a proxy).
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT="${REVERB_PORT}"
REVERB_PUBLIC_SCHEME="${REVERB_SCHEME}"

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ----- Mail (mailpit sail service; UI at localhost:8025) -----
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----- Ntfy push notifications (topic is set per-user in settings) -----
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# ----- Search (typesense sail service) -----
SCOUT_DRIVER=typesense
SCOUT_QUEUE=true
SCOUT_PREFIX=mm_
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz
# 'typesense' = Scout-backed search; 'fallback' = pre-Typesense substring filter via Sonarr/Radarr APIs.

# Cache generated embeddings so unchanged library texts aren't re-embedded.
AI_EMBEDDINGS_CACHE=true
MEDIAMANAGER_SEARCH_DRIVER=typesense
MEDIAMANAGER_SEARCH_MAX_RESULTS=20
MEDIAMANAGER_SEARCH_INSTANT_MAX_RESULTS=8

# ----- Dev tools (on in dev, off in prod) -----
TELESCOPE_ENABLED=true
CLOCKWORK_ENABLE=true
CLOCKWORK_WEB=true
CLOCKWORK_TOOLBAR=true

# ----- Octane (only used when running `octane:start` locally) -----
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false

# ----- Inertia SSR (off by default; run `npm run dev:ssr` to enable) -----
INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=http://127.0.0.1:13714

# ----- Fortify (Inertia uses view routes via Fortify::loginView etc.) -----
FORTIFY_VIEWS=true
FORTIFY_HOME=/dashboard

# ----- AWS / S3 (only if FILESYSTEM_DISK=s3) -----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ----- SSO (Authentik via Socialite) -----
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_BASE_URL=
AUTHENTIK_REDIRECT_URI="${APP_URL}/auth/authentik/callback"

# ----- AI (optional; runtime values live in app_settings) -----
MEDIAMANAGER_AI_ENABLED=false
MEDIAMANAGER_AI_MODE=executive
MEDIAMANAGER_AI_MODEL=gpt-5-mini
MEDIAMANAGER_AI_TITLE_MODEL=gpt-5.4-nano
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# External metadata sources for AI recommendations (optional)
TMDB_API_KEY=
TRAKT_CLIENT_ID=

# ----- External-API cache (must support tags → redis, NOT database) -----
MEDIAMANAGER_CACHE_STORE=redis
MEDIAMANAGER_CACHE_TTL_LIST=60
MEDIAMANAGER_CACHE_TTL_ENTITY=300
MEDIAMANAGER_CACHE_TTL_METADATA=600

# ----- Service Connection Seeder (optional) -----
SONARR_URL=
SONARR_API_KEY=
SONARR_WEBHOOK_TOKEN=
SONARR_NAME=

RADARR_URL=
RADARR_API_KEY=
RADARR_WEBHOOK_TOKEN=
RADARR_NAME=

EMBY_URL=
EMBY_API_KEY=
EMBY_WEBHOOK_TOKEN=
EMBY_NAME=

SEERR_URL=
SEERR_API_KEY=
SEERR_WEBHOOK_TOKEN=
SEERR_NAME=

PROWLARR_URL=
PROWLARR_API_KEY=
PROWLARR_WEBHOOK_TOKEN=
PROWLARR_NAME=

SABNZBD_URL=
SABNZBD_API_KEY=
SABNZBD_WEBHOOK_TOKEN=
SABNZBD_NAME=

# Prometheus /metrics endpoint. Empty token denies all access (endpoint stays
# closed). Set a long random secret to let your scraper reach GET /metrics.
METRICS_TOKEN=
METRICS_ENABLED=true
METRICS_ALLOWED_IPS=
