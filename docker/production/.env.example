# Production env. Copy to `.env` next to compose.yaml. Generate secrets fresh.
#
# APP_KEY:        docker run --rm <image> php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# REVERB_APP_*:   any random strings; ID/KEY are public, SECRET is server-only
# DB/TYPESENSE:   choose strong values
# Required values are unset; tune the rest only if defaults don't fit.

# ----- Image -----
IMAGE=ghcr.io/pentacore/media-manager:latest

# ----- App -----
APP_NAME=MediaManager
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://media.example.com
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# Octane multi-replica = use dedicated `migrate` service (compose runs it once before web boots).
RUN_MIGRATIONS=false

BCRYPT_ROUNDS=12

# ----- Logging (stderr → stdout aggregator / docker logs) -----
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# ----- Ports exposed by compose -----
WEB_PORT=8080
REVERB_BIND_PORT=8081

# ----- Database (pgsql container) -----
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=mediamanager
DB_USERNAME=mediamanager
DB_PASSWORD=
# 'require' for cross-host pg / TLS-only connections; 'prefer' allows downgrade.
DB_SSLMODE=prefer

# ----- Cache / session / queue → redis (valkey) -----
# Redis-backed avoids per-request DB round-trips and is required for queue retry semantics at scale.
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

# ----- Redis (valkey container, phpredis client) -----
REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CACHE_DB=1
REDIS_DB=0

# ----- Broadcasting (Reverb) -----
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Public hostname clients connect to. Reverse proxy should forward to the `reverb` service.
REVERB_HOST=ws.media.example.com
REVERB_PORT=443
REVERB_SCHEME=https
# Server-side: server binds inside container on 8080.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Comma-separated origins. Defaults to APP_URL; set explicitly if app is reachable from multiple hosts.
REVERB_APP_ALLOWED_ORIGINS="${APP_URL}"
REVERB_APP_RATE_LIMITING_ENABLED=true

# Vite-baked values matter only at build time. Already baked into image; here for completeness.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ----- Search (Typesense) -----
SCOUT_DRIVER=typesense
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=

# ----- Mail (set to smtp/postmark/ses/etc. in prod) -----
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ----- Telescope: off in prod (heavy + leaks request bodies) -----
TELESCOPE_ENABLED=false

# ----- Clockwork: off in prod -----
CLOCKWORK_ENABLE=false
CLOCKWORK_WEB=false
CLOCKWORK_TOOLBAR=false

# ----- Octane (frankenphp baked into image; tune if needed) -----
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=true
OCTANE_MAX_EXECUTION_TIME=30
OCTANE_GARBAGE=50

# ----- Inertia SSR: enable + point at SSR sidecar if running one -----
INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=http://ssr:13714

# ----- Fortify (SPA app) -----
FORTIFY_VIEWS=false
FORTIFY_HOME=/dashboard

# ----- SSO (Authentik via Socialite) -----
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_BASE_URL=
AUTHENTIK_REDIRECT_URI="${APP_URL}/auth/authentik/callback"

# ----- AI (optional; runtime values live in app_settings) -----
MEDIAMANAGER_AI_ENABLED=false
MEDIAMANAGER_AI_MODE=executive
MEDIAMANAGER_AI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

TMDB_API_KEY=
TRAKT_CLIENT_ID=

# ----- External-API cache (must support tags → redis, NOT database) -----
MEDIAMANAGER_CACHE_STORE=redis
MEDIAMANAGER_CACHE_TTL_LIST=60
MEDIAMANAGER_CACHE_TTL_ENTITY=300
MEDIAMANAGER_CACHE_TTL_METADATA=600

# ----- AWS (only if FILESYSTEM_DISK=s3) -----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
