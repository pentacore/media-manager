includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    # Level 6 adds missing parameter/iterable value types, matching the
    # typed-PHPDoc convention. Existing errors live in the baseline; new code
    # must be clean. Regenerate the baseline only to REMOVE fixed errors or
    # after a rebase: composer analyse -- --generate-baseline
    level: 6
    # On the bind mount, not the container's /tmp: a run as root (sail exec)
    # left root-owned cache files there that the sail user cannot overwrite.
    tmpDir: storage/framework/cache/phpstan
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
